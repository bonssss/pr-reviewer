# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Optional: enable when running behind a reverse proxy (trust N hops)
TRUST_PROXY=0

# Public URLs. BACKEND_URL is used to build the GitHub OAuth callback;
# FRONTEND_URL is the only cross-origin dashboard allowed by CORS.
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Optional explicit OAuth callback override (must match the GitHub App setup).
# GITHUB_CALLBACK_URL=https://api.example.com/api/auth/github/callback
# EXTRA_CORS_ORIGINS=https://admin.example.com

# Secrets (production requires >= 32 chars each; dev falls back to JWT_SECRET)
JWT_SECRET=super_secret_jwt_key_change_in_production
TOKEN_ENCRYPTION_KEY=

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pr_reviewer?schema=public"

# GitHub App Integration
# Use the Client ID / Client secret from the GitHub App settings page itself.
# Do NOT pair a GitHub App client ID with a secret from a separate OAuth App.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=""
GITHUB_PRIVATE_KEY_PATH=""

# OpenAI Configuration
# Leave OPENAI_BASE_URL empty for OpenAI. For a free OpenAI-compatible provider:
#   Gemini:     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#               OPENAI_MODEL=gemini-2.5-flash
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#               OPENAI_MODEL=llama-3.3-70b-versatile
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#               OPENAI_MODEL=<a :free model id>
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1
#               OPENAI_MODEL=llama3.2
# Without a key, the backend uses the offline heuristic engine instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
MAX_TOKENS_PER_REVIEW=4096

# Review Engine Settings
ENABLE_AUTO_REVIEW=true
AUTO_APPROVE_PR=false
MAX_DIFF_FILES=50
MAX_DIFF_CHARACTERS=100000

# Background worker
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_MS=2000
WORKER_STALE_MS=900000
WORKER_SHUTDOWN_TIMEOUT_MS=25000

# Rate limiting (set RATE_LIMIT_MAX=0 to disable, e.g. in tests)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=30
RERUN_RATE_LIMIT_MAX=10
