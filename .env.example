# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Standard local/Docker TCP connection:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pr_reviewer?schema=public"
# For local socket connection in development without TCP:
# DATABASE_URL="postgresql://bonsa:postgres@localhost:5433/pr_reviewer?host=/tmp&schema=public"

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=""
GITHUB_PRIVATE_KEY_PATH=""

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS_PER_REVIEW=4096

# Review Engine Settings
ENABLE_AUTO_REVIEW=true
AUTO_APPROVE_PR=false
MAX_DIFF_FILES=50
MAX_DIFF_CHARACTERS=100000
