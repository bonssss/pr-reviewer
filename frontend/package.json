{
  "name": "pr-reviewer-frontend",
  "version": "1.0.0",
  "description": "AI-powered GitHub Pull Request Reviewer Dashboard Frontend",
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && vite",
    "build": "npm run build:css && vite build",
    "build:css": "tailwindcss -i ./src/input.css -o ./tailwind.css --minify",
    "preview": "vite preview",
    "lint": "node --check app.js && node --check sanitize.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.11"
  }
}
