# Copy to .env and fill in every value before running `docker compose up`.
# Compose refuses to start when a required secret is missing.

# --- Required secrets -------------------------------------------------------
POSTGRES_PASSWORD=change_me_long_random_password
JWT_SECRET=change_me_at_least_32_characters_long
TOKEN_ENCRYPTION_KEY=change_me_at_least_32_characters_long
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=change_me_at_least_16_characters
OPENAI_API_KEY=

# --- GitHub App private key -------------------------------------------------
# Paste the full PEM (with real newlines or \n escapes) or mount a file and set
# GITHUB_PRIVATE_KEY_PATH to its absolute path inside the container.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=

# --- Public URLs ------------------------------------------------------------
# Use https:// for any non-localhost deployment (Secure session cookies).
BACKEND_URL=http://localhost
FRONTEND_URL=http://localhost
# Optional explicit OAuth callback:
# GITHUB_CALLBACK_URL=https://api.example.com/api/auth/github/callback

# --- Optional tuning --------------------------------------------------------
HTTP_PORT=80
OPENAI_MODEL=gpt-4o-mini
ENABLE_AUTO_REVIEW=true
RUN_MIGRATIONS=true
